---
// Cinta lima con los servicios. Se duplica la lista para que el loop no tenga cortes.
import { ticker } from '../config/home';
---

<div class="ticker li" aria-hidden="true">
  <div class="ticker__row">
    {[...ticker, ...ticker].map((t) => <span>{t}</span>)}
  </div>
</div>

<style>
  .ticker { overflow: hidden; white-space: nowrap; border-block: var(--stroke) solid var(--negro); }
  .ticker__row { display: inline-flex; padding-block: 14px; animation: tick 40s linear infinite; }
  span { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--display); font-size: clamp(18px, 2.4vw, 26px); text-transform: uppercase; }
  span::after { content: ''; width: 14px; height: 14px; background: var(--violeta); border: 2px solid var(--negro); }
  @keyframes tick { to { transform: translateX(-50%); } }
</style>
