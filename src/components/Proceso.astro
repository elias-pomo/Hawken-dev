---
// Proceso de trabajo en 4 pasos (línea horizontal en escritorio, vertical en mobile).
import Kicker from './Kicker.astro';
import Pendiente from './Pendiente.astro';
import { pasos } from '../config/home';
---

<section class="section bk" id="proceso" aria-labelledby="t-proceso">
  <div class="wrap">
    <Kicker numero="03" texto="Proceso" />
    <div class="sec-head">
      <h2 id="t-proceso">De la charla<br />a tu web online</h2>
      <p class="lead">Cuatro pasos y siempre sabés en qué etapa estamos.</p>
    </div>
    <ol class="steps">
      {pasos.map((p, i) => (
        <li>
          <span class="steps__n">{i + 1}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto} {p.pendiente && <Pendiente>{p.pendiente}</Pendiente>}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .steps::before { content: ''; position: absolute; left: 0; right: 0; top: 27px; height: var(--stroke); background: var(--edge); }
  li { position: relative; display: flex; flex-direction: column; gap: 12px; min-width: 0; padding-right: var(--s3); }
  .steps__n { width: 56px; height: 56px; margin-bottom: var(--s2); display: grid; place-items: center; background: var(--bg); border: var(--stroke) solid var(--edge); font-family: var(--display); font-size: 22px; }
  li:first-child .steps__n { background: var(--lima); color: var(--negro); border-color: var(--lima); }
  h3 { font-size: clamp(22px, 2.4vw, 28px); }
  p { font-size: 16px; color: var(--muted); }

  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; gap: var(--s4); }
    .steps::before { left: 27px; right: auto; top: 0; bottom: 0; width: var(--stroke); height: auto; }
    li { padding-left: 80px; padding-right: 0; }
    .steps__n { position: absolute; left: 0; top: 0; margin: 0; }
  }
</style>
