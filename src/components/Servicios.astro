---
// Servicios como "lo que te pasa hoy → lo que te armo".
import { Image } from 'astro:assets';
import Kicker from './Kicker.astro';
import { servicios, garantias } from '../config/home';
// Franjas recortadas de la foto del hero (fondohero.jpg), con fondo transparente para que la sección siga blanca.
import franjasSup from '../assets/decoracion/franjas-sup-izq.png';
import franjasInf from '../assets/decoracion/franjas-inf-der.png';
---

<section class="section wt servicios" id="servicios" aria-labelledby="t-serv">
  <Image src={franjasSup} alt="" aria-hidden="true" class="franjas franjas--sup" widths={[150, 300]} sizes="(max-width: 820px) 84px, 11vw" />
  <Image src={franjasInf} alt="" aria-hidden="true" class="franjas franjas--inf" widths={[170, 344]} sizes="(max-width: 820px) 130px, 20vw" />
  <div class="wrap">
    <Kicker numero="02" texto="Servicios" />
    <div class="sec-head">
      <h2 id="t-serv">Lo que hoy<br />te quita tiempo</h2>
      <p class="lead">Arranco por el problema de tu negocio, no por la tecnología.</p>
    </div>
    <ul class="ba">
      {servicios.map((s) => (
        <li class="ba__row">
          <p class="ba__antes"><span class="ba__pre">Hoy: </span><s>{s.antes}</s></p>
          <span class="ba__flecha" aria-hidden="true">→</span>
          <p class="ba__despues"><span class="ba__clave">{s.clave}</span> {s.resto}</p>
          <span class="tag tag--demo ba__tipo">{s.tipo}</span>
        </li>
      ))}
    </ul>
    <div class="garantias">
      {garantias.map((g) => (
        <div><strong>{g.titulo}</strong><p>{g.texto}</p></div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Decoración en dos esquinas, igual que la foto del hero: arriba a la izquierda y abajo a la derecha. */
  .servicios { position: relative; overflow: hidden; }
  .servicios .wrap { position: relative; z-index: 1; }
  .franjas { position: absolute; z-index: 0; height: auto; pointer-events: none; user-select: none; }
  /* Chica a propósito: tiene que quedar en el margen, sin cruzar el contador ni el título. */
  .franjas--sup { top: 0; left: 0; width: clamp(84px, 11vw, 220px); }
  .franjas--inf { bottom: 0; right: 0; width: clamp(130px, 20vw, 344px); }

  .ba { list-style: none; margin: 0; padding: 0; border-top: var(--stroke) solid var(--edge); }
  .ba__row { display: grid; grid-template-columns: minmax(0, 4fr) 64px minmax(0, 5fr) minmax(0, 2fr); gap: var(--s3); align-items: center; padding-block: var(--s4); border-bottom: 2px solid var(--edge); }
  .ba__antes { font-size: clamp(17px, 1.8vw, 20px); color: var(--muted); }
  .ba__antes s { text-decoration-thickness: 2px; text-decoration-color: var(--violeta); }
  .ba__pre { display: none; }
  .ba__flecha { font-family: var(--display); font-size: 28px; text-align: center; }
  .ba__despues { font-family: var(--display); font-size: clamp(22px, 2.8vw, 34px); line-height: 1; text-transform: uppercase; }
  .ba__clave { padding: 0 0.06em; transition: background 0.15s; }
  .ba__row:hover .ba__clave { background: var(--lima); }
  .ba__tipo { justify-self: end; }
  .garantias { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); margin-top: var(--s8); }
  .garantias div { display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-top: 16px; border-top: var(--stroke) solid var(--edge); }
  .garantias strong { font-size: 18px; }
  .garantias p { font-size: 16px; color: var(--muted); }

  @media (max-width: 820px) {
    .ba__row { grid-template-columns: 1fr; gap: 10px; }
    .ba__flecha { display: none; }
    .ba__tipo { justify-self: start; order: -1; }
    .ba__pre { display: inline; font-weight: 700; color: var(--fg); }
    .garantias { grid-template-columns: 1fr; margin-top: var(--s6); }
  }
  @media (hover: none) { .ba__clave { background: var(--lima); } }
</style>
