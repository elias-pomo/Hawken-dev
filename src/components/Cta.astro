---
// Banda lima de cierre con el botón de WhatsApp.
import { site, whatsappLink } from '../config/site';

interface Props {
  titulo: string;
  texto: string;
  mensaje?: string;
  boton?: string;
  compacto?: boolean;
}

const { titulo, texto, mensaje, boton = 'Escribime por WhatsApp', compacto = false } = Astro.props;
---

<section class="cta li" aria-labelledby="t-cta">
  <div class="wrap">
    <h2 id="t-cta" class:list={['cta__big', { 'cta__big--compacto': compacto }]}>{titulo}</h2>
    <div class="cta__row">
      <p>{texto}<span class="cta__num">WhatsApp: {site.whatsappDisplay}</span></p>
      <a class="btn btn--dark" href={whatsappLink(mensaje)} target="_blank" rel="noopener">{boton} <span class="arr">↗</span></a>
    </div>
  </div>
</section>

<style>
  .cta .wrap { padding-block: var(--s12) var(--s8); }
  .cta__big { margin: 0 0 var(--s6); font-size: clamp(34px, 10.5vw, 200px); line-height: 0.82; letter-spacing: -0.045em; }
  .cta__big--compacto { font-size: clamp(34px, 8vw, 140px); }
  .cta__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s4); align-items: end; padding-top: var(--s4); border-top: var(--stroke) solid var(--negro); }
  .cta__row p { font-size: clamp(18px, 2vw, 22px); font-weight: 500; }
  .cta__num { display: block; margin-top: 6px; font-size: 15px; font-variant-numeric: tabular-nums; }
  @media (max-width: 700px) {
    .cta .wrap { padding-block: var(--s8) var(--s6); }
    .cta__row { grid-template-columns: 1fr; }
    .cta__row .btn { width: 100%; }
  }
</style>
