---
// Hero: titular tipográfico + celular donde el visitante saca un turno de ejemplo en 3 toques.
// Los servicios, precios y horarios de la demo son los de Martega's (lun a sáb, 15 a 22 h).
import Phone from './phone/Phone.astro';
import { whatsappLink } from '../config/site';
---

<section class="hero wt" aria-labelledby="t-hero">
  <div class="wrap">
    <div class="hero__copy">
      <div class="hero__meta"><span>Tucumán, Argentina</span><span>Online para todo el país</span></div>
      <h1 id="t-hero">
        <span class="ln">Tu negocio</span>
        <span class="ln"><span class="hero__hl">atiende</span></span>
        <span class="ln hero__out">aunque vos</span>
        <span class="ln">no estés</span>
      </h1>
      <p class="lead">Webs, tiendas online y sistemas de <strong>turnos, stock y ventas</strong>. Tus clientes reservan, consultan y compran desde el celular, a cualquier hora.</p>
      <div class="btns btns--full">
        <a class="btn btn--lima" href={whatsappLink()} target="_blank" rel="noopener">Escribime por WhatsApp <span class="arr">↗</span></a>
        <a class="btn btn--ghost" href="#proyectos">Ver proyectos</a>
      </div>
    </div>

    <div class="stage">
      <div class="stage__label">Ejemplo<br />ilustrativo</div>
      <Phone hora="20:30">
        <div class="phone__screen demo" id="demo" aria-live="polite">
          <div class="demo__top"><b>Martega's</b><div class="demo__prog"><i class="on"></i><i></i><i></i></div></div>
          <p class="demo__q">¿Qué te hacés?</p>
          <button type="button" class="demo__opt" data-serv="0">Corte<span>$12.000</span></button>
          <button type="button" class="demo__opt" data-serv="1">Corte y barba<span>$15.000</span></button>
          <p class="demo__hint">Sin registrarte. Tocá un servicio.</p>
        </div>
      </Phone>
    </div>
  </div>
</section>

<script>
  type Estado = { paso: 1 | 2 | 3 | 4; serv: number; hora: string; codigo: string };

  const servicios = [
    { nombre: 'Corte', precio: '$12.000' },
    { nombre: 'Corte y barba', precio: '$15.000' },
  ];
  const horas = ['15:00', '16:00', '17:00', '18:00', '19:00', '20:00', '21:00', '22:00'];
  const ocupadas = new Set(['16:00', '19:00', '21:00']);

  const scr = document.getElementById('demo');
  let st: Estado = { paso: 1, serv: 0, hora: '', codigo: '' };

  const progreso = (n: number) =>
    `<div class="demo__prog" aria-label="Paso ${n} de 3">${[1, 2, 3].map((i) => `<i class="${i <= n ? 'on' : ''}"></i>`).join('')}</div>`;
  const top = (n: number) => `<div class="demo__top"><b>Martega's</b>${progreso(n)}</div>`;
  const fila = (a: string, b: string) => `<div class="demo__sum"><span>${a}</span><span>${b}</span></div>`;

  const pantallas: Record<Estado['paso'], () => string> = {
    1: () =>
      top(1) +
      '<p class="demo__q">¿Qué te hacés?</p>' +
      servicios.map((s, i) => `<button type="button" class="demo__opt" data-serv="${i}">${s.nombre}<span>${s.precio}</span></button>`).join('') +
      '<p class="demo__hint">Sin registrarte. Tocá un servicio.</p>',
    2: () =>
      top(2) +
      '<p class="demo__q">Jueves · ¿a qué hora?</p><div class="demo__slots">' +
      horas.map((h) => `<button type="button" class="demo__slot" data-hora="${h}"${ocupadas.has(h) ? ' disabled aria-label="' + h + ' ocupado"' : ''}>${h}</button>`).join('') +
      '</div>' +
      fila(servicios[st.serv].nombre, servicios[st.serv].precio) +
      '<button type="button" class="demo__link" data-ir="1">← Cambiar servicio</button>',
    3: () =>
      top(3) +
      '<p class="demo__q">Confirmá tu turno</p>' +
      fila('Servicio', servicios[st.serv].nombre) +
      fila('Día y hora', `Jueves ${st.hora}`) +
      fila('Precio', servicios[st.serv].precio) +
      '<button type="button" class="demo__link" data-ir="2">← Cambiar horario</button>' +
      '<button type="button" class="demo__ok" data-ok>Confirmar turno</button>',
    4: () =>
      '<div class="demo__top"><b>Martega\'s</b><span class="label">Listo</span></div>' +
      '<div class="demo__done"><p class="demo__q">¡Turno reservado!</p>' +
      `<p>Jueves ${st.hora} · ${servicios[st.serv].nombre}</p>` +
      '<span class="label">Tu código</span>' +
      `<div class="demo__code">${st.codigo.split('').map((d) => `<b>${d}</b>`).join('')}</div>` +
      '<p class="demo__hint">Con este código lo buscás o lo cancelás. Así reservan los clientes de Martega\'s.</p></div>' +
      '<button type="button" class="demo__link" data-reiniciar>Probar de nuevo</button>',
  };

  const render = () => {
    if (scr) scr.innerHTML = pantallas[st.paso]();
  };

  scr?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b || b.disabled) return;
    const d = b.dataset;
    if (d.serv !== undefined) st = { ...st, paso: 2, serv: Number(d.serv) };
    else if (d.hora) st = { ...st, paso: 3, hora: d.hora };
    else if (d.ir) st = { ...st, paso: Number(d.ir) as Estado['paso'] };
    else if (d.ok !== undefined) st = { ...st, paso: 4, codigo: String(1000 + Math.floor(Math.random() * 9000)) };
    else if (d.reiniciar !== undefined) st = { paso: 1, serv: 0, hora: '', codigo: '' };
    render();
  });
</script>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero .wrap { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s6); align-items: center; padding-block: var(--s8) var(--s12); }
  .hero__copy { display: flex; flex-direction: column; gap: var(--s4); min-width: 0; }
  .hero__meta { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .hero__meta span { display: flex; align-items: center; gap: 8px; }
  .hero__meta span::before { content: ''; width: 10px; height: 10px; background: var(--violeta); }
  h1 { font-size: clamp(44px, 6.4vw, 96px); line-height: 0.88; letter-spacing: -0.035em; }
  .ln { display: block; }
  .hero__hl { display: inline-block; margin-left: -0.08em; padding: 0 0.08em; background: var(--lima); box-shadow: inset 0 -0.06em 0 var(--negro); }
  .hero__out { color: var(--blanco); -webkit-text-stroke: 3px var(--negro); paint-order: stroke fill; }
  .lead { max-width: 46ch; }
  .lead strong { color: var(--negro); }

  .stage { position: relative; justify-self: center; width: min(340px, 100%); padding: 28px 28px 40px 0; }
  .stage::before { content: ''; position: absolute; top: 0; right: 0; width: 78%; height: 82%; background: var(--violeta); }
  .stage::after { content: 'PROBALO'; position: absolute; right: -6px; bottom: 6px; font-family: var(--display); font-size: 13px; letter-spacing: 0.2em; writing-mode: vertical-rl; transform: rotate(180deg); }
  .stage__label { position: absolute; z-index: 3; left: -12px; top: 44%; padding: 8px 10px; background: var(--lima); border: var(--stroke) solid var(--negro); box-shadow: 4px 4px 0 var(--negro); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; line-height: 1.25; text-transform: uppercase; }

  @media (max-width: 900px) {
    .hero .wrap { grid-template-columns: 1fr; padding-block: var(--s6) var(--s8); }
    .stage { margin-top: var(--s2); width: min(300px, 100%); }
    .stage__label { left: 0; top: 0; }
  }
  @media (max-width: 420px) { .hero__out { -webkit-text-stroke-width: 2px; } }
</style>

<!-- La demo se redibuja con JS: sus estilos son globales, con el prefijo .demo. -->
<style is:global>
  .demo__top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .demo__top b { font-family: var(--display); font-size: 15px; text-transform: uppercase; }
  .demo__top .label { font-size: 11px; }
  .demo__prog { display: flex; gap: 4px; }
  .demo__prog i { width: 18px; height: 6px; background: var(--linea-clara); }
  .demo__prog i.on { background: var(--negro); }
  .demo__q { font-family: var(--display); font-size: 20px; line-height: 1.05; text-transform: uppercase; }
  .demo__opt { display: flex; justify-content: space-between; align-items: center; gap: 8px; width: 100%; min-height: 52px; padding: 10px 12px;
    background: var(--blanco); color: var(--negro); border: 2px solid var(--negro); font-weight: 700; font-size: 14px; text-align: left; cursor: pointer; }
  .demo__opt span { font-weight: 500; font-variant-numeric: tabular-nums; }
  .demo__opt:hover, .demo__slot:hover:not(:disabled) { background: var(--lima-suave); }
  .demo__slots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .demo__slot { min-height: 46px; background: var(--blanco); color: var(--negro); border: 2px solid var(--negro); font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums; cursor: pointer; }
  .demo__slot:disabled { border-style: dashed; border-color: #BDBDBD; color: #767676; text-decoration: line-through; cursor: not-allowed; }
  .demo__sum { display: flex; justify-content: space-between; gap: 8px; padding-top: 10px; border-top: 2px solid var(--negro); font-size: 13px; font-variant-numeric: tabular-nums; }
  .demo__ok { margin-top: auto; min-height: 50px; border: 0; background: var(--negro); color: var(--lima); font-weight: 700; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; }
  .demo__link { width: fit-content; min-height: 44px; padding: 6px 0; background: none; border: 0; color: var(--negro); font-weight: 700; font-size: 13px; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .demo__hint { margin-top: auto; font-size: 12px; color: var(--gris-claro); }
  .demo__done { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 12px; }
  .demo__done .demo__hint { margin-top: 0; }
  .demo__code { display: flex; gap: 6px; }
  .demo__code b { width: 46px; height: 58px; display: grid; place-items: center; border: 2px solid var(--negro); background: var(--lima); font-family: var(--display); font-size: 26px; font-variant-numeric: tabular-nums; }
</style>
