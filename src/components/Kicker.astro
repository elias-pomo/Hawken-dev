---
// Encabezado chico de sección: contador violeta, texto y un filete hasta el borde.
interface Props {
  numero: string;
  texto: string;
}

const { numero, texto } = Astro.props;
---

<div class="kicker">
  <span class="kicker__n">{numero}</span>
  <span class="kicker__t">{texto}</span>
</div>

<style>
  .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: var(--s4); }
  .kicker::after { content: ''; flex: 1; height: var(--stroke); background: var(--edge); }
  .kicker__n { padding: 4px 8px; background: var(--violeta); color: var(--blanco); font-size: 13px; font-weight: 700; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; }
  .kicker__t { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
</style>
