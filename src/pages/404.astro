---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada | Hawken" description="Esta página no existe.">
  <main class="section wt">
    <div class="wrap nf">
      <p class="label">Error 404</p>
      <h1>Esta página <span class="hl">no existe</span></h1>
      <p class="lead">Puede que el link esté mal escrito o que la página se haya movido.</p>
      <div class="btns">
        <a class="btn btn--lima" href="/">Ir al inicio</a>
        <a class="btn btn--ghost" href="/#proyectos">Ver proyectos</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; padding-block: var(--s12); }
  h1 { font-size: clamp(44px, 8vw, 100px); line-height: 0.9; letter-spacing: -0.03em; }
</style>
